class Animal:
    def __init__(self, name):
        self.name = name

    def eat(self):
        print(f"{self.name} is eating.")

    def make_sound(self):
        print(f"{self.name} makes a sound.")


class Lion(Animal):
    def eat(self):
        print(f"Lion {self.name} eats fresh meat.")

    def make_sound(self):
        print(f"Lion {self.name} roars loudly.")


class Elephant(Animal):
    def eat(self):
        print(f"Elephant {self.name} eats grass and fruits.")

    def make_sound(self):
        print(f"Elephant {self.name} trumpets.")


class Monkey(Animal):
    def eat(self):
        print(f"Monkey {self.name} eats bananas.")

    def make_sound(self):
        print(f"Monkey {self.name} chatters.")


animals = [Lion("Simba"), Elephant("Dumbo"), Monkey("George")]

for animal in animals:
    animal.make_sound()
    animal.eat()